# Copy to .env and edit if you need to override anything.
# Every setting is optional -- config.yaml holds the defaults.
# Env vars override config.yaml. Nested keys use a double underscore.

# Where the crawled corpus, images and index live (~190 MB, ~7,000 files).
# Point this outside the repo if your project folder is inside a synced
# directory such as OneDrive, Dropbox or iCloud -- otherwise the sync client
# will churn on every rebuild.
#
#   Windows : JMPDOCS_PATHS__DATA_DIR=C:/Users/<you>/AppData/Local/jmp-mcp/data
#   macOS   : JMPDOCS_PATHS__DATA_DIR=/Users/<you>/Library/Application Support/jmp-mcp/data
#   Linux   : JMPDOCS_PATHS__DATA_DIR=/home/<you>/.local/share/jmp-mcp/data
#
# JMPDOCS_PATHS__DATA_DIR=

# --- models ------------------------------------------------------------
# JMPDOCS_LLM__BASE_URL=http://localhost:11434
# JMPDOCS_LLM__ANSWER_MODEL=qwen3:8b
# JMPDOCS_LLM__FAST_MODEL=qwen3:4b

# --- retrieval ---------------------------------------------------------
# JMPDOCS_RETRIEVAL__K_FINAL=6
# JMPDOCS_RETRIEVAL__RERANK=false
